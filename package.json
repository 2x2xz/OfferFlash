{
  "name": "offerflash",
  "version": "0.24.0",
  "main": "apps/desktop/main.cjs",
  "description": "Local career assistant with job matching, application tracking and an embedded browser",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "demo": "node --import tsx scripts/runtime-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build-desktop.mjs",
    "start": "npm run build && electron apps/desktop/main.cjs",
    "start:built": "electron apps/desktop/main.cjs",
    "test:desktop": "npm run build && electron apps/desktop/main.cjs --smoke-test",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "check": "npm run typecheck && npm test && npm run check:skills && npm run check:public",
    "eval:agent": "node --import tsx scripts/evaluate-agent.ts",
    "report:agent": "node --import tsx scripts/report-agent-evaluation.ts",
    "check:skills": "node --import tsx scripts/check-career-skills.ts",
    "check:live-form": "node scripts/live-form-check.mjs",
    "check:live-product": "npm run build && electron apps/desktop/main.cjs --live-product-check",
    "check:live-stability": "node --import tsx scripts/check-live-stability.ts",
    "check:public": "node scripts/check-public-package.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "release:export": "node scripts/export-private-release.mjs",
    "build:benchmark": "node scripts/build-benchmark.mjs",
    "bench": "npm run build:benchmark && node --import tsx scripts/evaluate-offerflash.ts",
    "bench:career": "npm run build:benchmark && electron apps/desktop/benchmark-career-main.cjs --isolated-benchmark --smoke-test",
    "bench:collect": "node --import tsx scripts/collect-benchmark-jobs.ts",
    "bench:review": "node --import tsx scripts/prepare-job-review.ts",
    "bench:score-review": "node --import tsx scripts/score-job-review.ts",
    "bench:agent-live": "node --import tsx scripts/run-live-agent-benchmark.mjs",
    "bench:recommendations": "node --import tsx scripts/evaluate-recommendations.ts",
    "bench:otel": "node --import tsx scripts/export-benchmark-otel.ts",
    "bench:summary": "node --import tsx scripts/summarize-benchmark.ts",
    "bench:verify": "node --import tsx scripts/verify-benchmark-artifacts.ts",
    "bench:eligibility": "node --import tsx scripts/evaluate-eligibility-repair.ts",
    "bench:repair-report": "node --import tsx scripts/report-benchmark-repair.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "lucide-react": "1.55.0",
    "pdf-parse": "2.4.5",
    "playwright-core": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sql.js": "1.14.2",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.4.11",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
